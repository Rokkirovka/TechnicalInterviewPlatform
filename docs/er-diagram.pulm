@startuml
' ER-диаграмма для платформы технических собеседований

entity "User" as users {
  * Id : INT <<PK>>
  --
  Login : VARCHAR(256) <<UK>>
  PasswordHash : VARCHAR(255)
  FullName : VARCHAR(200)
  IsActive : BOOLEAN
  CreatedAt : TIMESTAMP
  UpdatedAt : TIMESTAMP
}

entity "UserRoles" as user_roles {
  * UserId : INT <<PK,FK>>
  * RoleName : VARCHAR(50) <<PK>>
}

entity "Candidate" as candidates {
  * Id : INT <<PK>>
  --
  FullName : VARCHAR(200)
  Phone : VARCHAR(20)
  City : VARCHAR(100)
  Education : TEXT
  PreviousJob : VARCHAR(200)
  CreatedAt : TIMESTAMP
  UpdatedAt : TIMESTAMP
}

entity "Skill" as skills {
  * Id : INT <<PK>>
  --
  Name : VARCHAR(100) <<UK>>
  Category : VARCHAR(50)
  CreatedAt : TIMESTAMP
  UpdatedAt : TIMESTAMP
}

entity "CandidateSkill" as candidate_skills {
  * CandidateId : INT <<PK,FK>>
  * SkillId : INT <<PK,FK>>
  Level : ProficiencyLevel
  CreatedAt : TIMESTAMP
  UpdatedAt : TIMESTAMP
}

enum "ProficiencyLevel" as proficiency_level {
  Beginner
  Middle
  High
}

candidate_skills --> proficiency_level

candidates ||--o{ candidate_skills
skills ||--o{ candidate_skills

entity "Vacancy" as vacancies {
  * Id : INT <<PK>>
  --
  Title : VARCHAR(200)
  Description : TEXT
  Department : VARCHAR(100)
  IsActive : BOOLEAN
  CreatedAt : TIMESTAMP
  UpdatedAt : TIMESTAMP
}

entity "Interview" as interviews {
  * Id : INT <<PK>>
  --
  CandidateId : INT <<FK>>
  VacancyId : INT <<FK>>
  ScheduledAt : TIMESTAMP
  Status : InterviewStatus
  CreatedByUserId : INT <<FK>>
  AssignedToUserId : INT <<FK>>
  CreatedAt : TIMESTAMP
  UpdatedAt : TIMESTAMP
}

enum "InterviewStatus" as interview_status {
  Scheduled
  Passed
  Approved
  Rejected
  ToNextStage
}

entity "Comment" as comments {
  * Id : INT <<PK>>
  --
  InterviewId : INT <<FK>>
  AuthorId : INT <<FK>>
  Content : TEXT
  CreatedAt : TIMESTAMP
  UpdatedAt : TIMESTAMP
}

candidates ||--o{ interviews
vacancies ||--o{ interviews
interviews ||--o{ comments
comments }o--|| users
interviews --> interview_status

entity "InterviewStage" as interview_stages {
  * Id : INT <<PK>>
  --
  InterviewId : INT <<FK>>
  StageName : VARCHAR(100)
  Duration : INT
  Description : TEXT
  OrderNumber : INT
}

interviews ||--o{ interview_stages

entity "Competency" as competencies {
  * Id : INT <<PK>>
  --
  Name : VARCHAR(100)
  Description : TEXT
  IsActive : BOOLEAN
  CreatedAt : TIMESTAMP
  UpdatedAt : TIMESTAMP
}

entity "VacancyCompetency" as vacancy_competencies {
  * VacancyId : INT <<PK,FK>>
  * CompetencyId : INT <<PK,FK>>
  CreatedAt : TIMESTAMP
  UpdatedAt : TIMESTAMP
}

vacancies ||--o{ vacancy_competencies
competencies ||--o{ vacancy_competencies

entity "CompetencyScore" as competency_scores {
  * Id : INT <<PK>>
  --
  InterviewId : INT <<FK>>
  CompetencyId : INT <<FK>>
  Score : INT
  Comment : TEXT
  CreatedAt : TIMESTAMP
  UpdatedAt : TIMESTAMP
}

users ||--o{ user_roles

interviews }o--|| users
interviews }o--|| users

interviews ||--o{ competency_scores
competencies ||--o{ competency_scores

entity "UserDeletionLog" as user_deletion_logs {
  * Id : INT <<PK>>
  --
  DeletedByUserId : INT <<FK>>
  EntityId : INT
  DeletionReason : TEXT
  DeletedAt : TIMESTAMP
}

entity "CandidateDeletionLog" as candidate_deletion_logs {
  * Id : INT <<PK>>
  --
  DeletedByUserId : INT <<FK>>
  EntityId : INT
  DeletionReason : TEXT
  DeletedAt : TIMESTAMP
}

entity "SkillDeletionLog" as skill_deletion_logs {
  * Id : INT <<PK>>
  --
  DeletedByUserId : INT <<FK>>
  EntityId : INT
  DeletionReason : TEXT
  DeletedAt : TIMESTAMP
}

entity "VacancyDeletionLog" as vacancy_deletion_logs {
  * Id : INT <<PK>>
  --
  DeletedByUserId : INT <<FK>>
  EntityId : INT
  DeletionReason : TEXT
  DeletedAt : TIMESTAMP
}

entity "InterviewDeletionLog" as interview_deletion_logs {
  * Id : INT <<PK>>
  --
  DeletedByUserId : INT <<FK>>
  EntityId : INT
  DeletionReason : TEXT
  DeletedAt : TIMESTAMP
}

entity "CommentDeletionLog" as comment_deletion_logs {
  * Id : INT <<PK>>
  --
  DeletedByUserId : INT <<FK>>
  EntityId : INT
  DeletionReason : TEXT
  DeletedAt : TIMESTAMP
}

entity "CompetencyDeletionLog" as competency_deletion_logs {
  * Id : INT <<PK>>
  --
  DeletedByUserId : INT <<FK>>
  EntityId : INT
  DeletionReason : TEXT
  DeletedAt : TIMESTAMP
}

users ||--o{ user_deletion_logs
users ||--o{ candidate_deletion_logs
users ||--o{ skill_deletion_logs
users ||--o{ vacancy_deletion_logs
users ||--o{ interview_deletion_logs
users ||--o{ comment_deletion_logs
users ||--o{ competency_deletion_logs

@enduml